(export (version "E")
  (design
    (source "amiga_floppy_emu.kicad_sch")
    (date "2026-03-30")
    (tool "Custom Generator 1.0")
  )
  (components
    (comp (ref "U1")
      (value "ESP32-S3-Mini-1")
      (footprint "RF_Module:ESP32-S3-MINI-1")
      (fields
        (field (name "Description") "ESP32-S3 Mini Module N8R8")
      )
    )
    (comp (ref "U2")
      (value "74HCT125")
      (footprint "Package_DIP:DIP-14_W7.62mm")
      (fields
        (field (name "Description") "Level Shifter 3.3V->5V (Outputs to Amiga)")
      )
    )
    (comp (ref "U3")
      (value "74HCT125")
      (footprint "Package_DIP:DIP-14_W7.62mm")
      (fields
        (field (name "Description") "Level Shifter 5V->3.3V (Inputs from Amiga)")
      )
    )
    (comp (ref "J1")
      (value "IDC-34")
      (footprint "Connector_IDC:IDC-Header_2x17_P2.54mm_Vertical")
      (fields
        (field (name "Description") "34-pin Floppy Connector to Amiga")
      )
    )
    (comp (ref "C1")
      (value "100nF")
      (footprint "Capacitor_SMD:C_0805_2012Metric")
      (fields
        (field (name "Description") "Bypass cap U2")
      )
    )
    (comp (ref "C2")
      (value "100nF")
      (footprint "Capacitor_SMD:C_0805_2012Metric")
      (fields
        (field (name "Description") "Bypass cap U3")
      )
    )
    (comp (ref "C3")
      (value "10uF")
      (footprint "Capacitor_SMD:C_0805_2012Metric")
      (fields
        (field (name "Description") "Bulk cap power")
      )
    )
  )
  (nets
    ; === ACCENT: ACCENT: ACCENT: ACCENT: ACCENT: ACCENT: ACCENT: ACCENT ===
    ; Power Nets
    (net (code "1") (name "GND")
      (node (ref "U1") (pin "GND"))
      (node (ref "U2") (pin "7"))
      (node (ref "U3") (pin "7"))
      (node (ref "J1") (pin "1"))
      (node (ref "J1") (pin "3"))
      (node (ref "J1") (pin "5"))
      (node (ref "J1") (pin "7"))
      (node (ref "J1") (pin "9"))
      (node (ref "J1") (pin "11"))
      (node (ref "J1") (pin "13"))
      (node (ref "J1") (pin "15"))
      (node (ref "J1") (pin "17"))
      (node (ref "J1") (pin "19"))
      (node (ref "J1") (pin "21"))
      (node (ref "J1") (pin "23"))
      (node (ref "J1") (pin "25"))
      (node (ref "J1") (pin "27"))
      (node (ref "J1") (pin "29"))
      (node (ref "J1") (pin "31"))
      (node (ref "J1") (pin "33"))
      (node (ref "C1") (pin "2"))
      (node (ref "C2") (pin "2"))
      (node (ref "C3") (pin "2"))
    )
    (net (code "2") (name "+5V")
      (node (ref "U2") (pin "14"))
      (node (ref "C1") (pin "1"))
      ; 5V from Amiga floppy connector (optional, or external)
    )
    (net (code "3") (name "+3V3")
      (node (ref "U1") (pin "3V3"))
      (node (ref "U3") (pin "14"))
      (node (ref "C2") (pin "1"))
      (node (ref "C3") (pin "1"))
    )

    ; === U2: OUTPUT Level Shifter (ESP32 3.3V → Amiga 5V) ===
    ; U2 powered at 5V, accepts 3.3V HIGH as valid input
    ; Gate 1: INDEX (GPIO4 → Amiga Pin 8)
    (net (code "10") (name "INDEX_3V3")
      (node (ref "U1") (pin "GPIO4"))
      (node (ref "U2") (pin "2"))
    )
    (net (code "11") (name "INDEX_5V")
      (node (ref "U2") (pin "3"))
      (node (ref "J1") (pin "8"))
    )
    (net (code "12") (name "U2_OE1")
      (node (ref "U2") (pin "1"))
      ; Tie to GND (always enabled)
    )

    ; Gate 2: TRACK0 (GPIO8 → Amiga Pin 26)
    (net (code "13") (name "TRK0_3V3")
      (node (ref "U1") (pin "GPIO8"))
      (node (ref "U2") (pin "5"))
    )
    (net (code "14") (name "TRK0_5V")
      (node (ref "U2") (pin "6"))
      (node (ref "J1") (pin "26"))
    )
    (net (code "15") (name "U2_OE2")
      (node (ref "U2") (pin "4"))
      ; Tie to GND
    )

    ; Gate 3: WRPROT (GPIO3 → Amiga Pin 28)
    (net (code "16") (name "WRPROT_3V3")
      (node (ref "U1") (pin "GPIO3"))
      (node (ref "U2") (pin "9"))
    )
    (net (code "17") (name "WRPROT_5V")
      (node (ref "U2") (pin "8"))
      (node (ref "J1") (pin "28"))
    )
    (net (code "18") (name "U2_OE3")
      (node (ref "U2") (pin "10"))
      ; Tie to GND
    )

    ; Gate 4: RDDATA (GPIO9/RMT → Amiga Pin 30)
    (net (code "19") (name "RDDATA_3V3")
      (node (ref "U1") (pin "GPIO9"))
      (node (ref "U2") (pin "12"))
    )
    (net (code "20") (name "RDDATA_5V")
      (node (ref "U2") (pin "11"))
      (node (ref "J1") (pin "30"))
    )
    (net (code "21") (name "U2_OE4")
      (node (ref "U2") (pin "13"))
      ; Tie to GND
    )

    ; === U3: INPUT Level Shifter (Amiga 5V → ESP32 3.3V) ===
    ; U3 powered at 3.3V, 5V-tolerant inputs shift down to 3.3V
    ; Gate 1: DRVSEL0 (Amiga Pin 10 → GPIO5)
    (net (code "30") (name "DRVSEL0_5V")
      (node (ref "J1") (pin "10"))
      (node (ref "U3") (pin "2"))
    )
    (net (code "31") (name "DRVSEL0_3V3")
      (node (ref "U3") (pin "3"))
      (node (ref "U1") (pin "GPIO5"))
    )
    (net (code "32") (name "U3_OE1")
      (node (ref "U3") (pin "1"))
      ; Tie to GND
    )

    ; Gate 2: MOTOR (Amiga Pin 16 → GPIO7)
    (net (code "33") (name "MOTOR_5V")
      (node (ref "J1") (pin "16"))
      (node (ref "U3") (pin "5"))
    )
    (net (code "34") (name "MOTOR_3V3")
      (node (ref "U3") (pin "6"))
      (node (ref "U1") (pin "GPIO7"))
    )
    (net (code "35") (name "U3_OE2")
      (node (ref "U3") (pin "4"))
      ; Tie to GND
    )

    ; Gate 3: DIRECTION (Amiga Pin 18 → GPIO15)
    (net (code "36") (name "DIR_5V")
      (node (ref "J1") (pin "18"))
      (node (ref "U3") (pin "9"))
    )
    (net (code "37") (name "DIR_3V3")
      (node (ref "U3") (pin "8"))
      (node (ref "U1") (pin "GPIO15"))
    )
    (net (code "38") (name "U3_OE3")
      (node (ref "U3") (pin "10"))
      ; Tie to GND
    )

    ; Gate 4: STEP (Amiga Pin 20 → GPIO16)
    (net (code "39") (name "STEP_5V")
      (node (ref "J1") (pin "20"))
      (node (ref "U3") (pin "12"))
    )
    (net (code "40") (name "STEP_3V3")
      (node (ref "U3") (pin "11"))
      (node (ref "U1") (pin "GPIO16"))
    )
    (net (code "41") (name "U3_OE4")
      (node (ref "U3") (pin "13"))
      ; Tie to GND
    )

    ; === ACCENT: Additional signals (direct or via resistor dividers) ===
    ; WRDATA (Amiga Pin 22 → GPIO17) - Needs 5V→3.3V
    ; Use external resistor divider: 1kΩ + 2kΩ
    (net (code "50") (name "WRDATA_5V")
      (node (ref "J1") (pin "22"))
      ; → 1kΩ → junction → 2kΩ → GND
      ; junction → GPIO17
    )

    ; SIDE SELECT (Amiga Pin 32 → GPIO46) - Needs 5V→3.3V
    ; Use external resistor divider: 1kΩ + 2kΩ
    (net (code "51") (name "SIDE_5V")
      (node (ref "J1") (pin "32"))
      ; → 1kΩ → junction → 2kΩ → GND
      ; junction → GPIO46
    )

    ; DISKCHANGE (GPIO10 → Amiga Pin 34)
    ; Needs additional output gate - reuse a spare or add 3rd 74HCT125
    ; For now, direct connection (3.3V may be recognized as HIGH by Amiga)
    (net (code "52") (name "DISKCHANGE_3V3")
      (node (ref "U1") (pin "GPIO10"))
      ; → Direct or via pull-up to 5V with open-drain
      (node (ref "J1") (pin "34"))
    )
  )
)
